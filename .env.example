# Entorno de ejecución: development | production
NODE_ENV=development

PORT=3000
MONGODB_URI=mongodb://localhost:27017/ecommerce-db-test

# URL del frontend (usada como origen CORS por defecto si CORS_ALLOWED_ORIGINS no está definida)
FRONTEND_URL=http://localhost:3000

# Orígenes permitidos por CORS, separados por comas. Tiene prioridad sobre FRONTEND_URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=secret_token
JWT_REFRESH_TOKEN=secret_refresh_token
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# API key de Google Gemini, usada por el chatbot. Consíguela en
# https://aistudio.google.com/apikey — nunca la subas al repositorio.
GEMINI_API_KEY=
